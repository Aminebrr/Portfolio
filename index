<style>

/* ═══════════════════════════════════
   DESIGN TOKENS — warm editorial palette
   Light: cream/parchment bg, charcoal text, amber accent
═══════════════════════════════════ */
:root {
  --bg:        #F7F4EF;
  --bg2:       #EFEBE3;
  --bg3:       #E6E1D8;
  --bg-dark:   #1E1C19;
  --bg-dark2:  #252320;
  --border:    rgba(30,28,25,0.1);
  --border2:   rgba(30,28,25,0.18);
  --accent:    #C8842A;
  --accent2:   #E09A3A;
  --accent-bg: rgba(200,132,42,0.08);
  --text1:     #1E1C19;
  --text2:     #5C5750;
  --text3:     #7A7570;
  --serif:     'Playfair Display', 'Georgia', 'Times New Roman', serif;
  --sans:      'DM Sans', 'Helvetica Neue', system-ui, sans-serif;
  --mono:      'DM Mono', 'Courier New', monospace;
  --nav-h:     64px;
  --max:       1160px;
  --r:         10px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text1);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.68;
  font-feature-settings: 'kern' 1, 'liga' 1;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; height: auto; }

/* ─── NAVIGATION ─────────────────────────── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--nav-h);
  padding: 0 40px;
  background: rgba(247,244,239,0.88);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 0.5px solid var(--border);
  z-index: 100;
  display: flex;
  align-items: center;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
}
.logo {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 600;
  color: var(--text1);
  letter-spacing: -0.01em;
}
.logo span { color: var(--accent); }
.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
}
.nav-links a {
  font-size: 12.5px;
  font-weight: 400;
  color: var(--text2);
  letter-spacing: 0.01em;
  transition: color .2s;
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -3px; left: 0;
  width: 0; height: 1px;
  background: var(--accent);
  transition: width .25s;
}
.nav-links a:hover { color: var(--text1); }
.nav-links a:hover::after { width: 100%; }
.nav-links a.active { color: var(--accent); }
.nav-links a.active::after { width: 100%; }
.nav-right { display: flex; align-items: center; gap: 14px; }
.lang-sw { font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.06em; color: var(--text3); display: flex; gap: 5px; align-items: center; }
.lang-sw a { color: var(--text2); transition: color .2s; }
.lang-sw a:hover { color: var(--accent); }
.lang-sw a.lang-active { color: var(--accent); font-weight: 500; }
.lang-sw span { color: var(--text3); }
.btn-nav {
  font-family: var(--sans);
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.01em;
  padding: 8px 20px;
  border-radius: 7px;
  background: var(--text1);
  color: var(--bg);
  border: none;
  cursor: pointer;
  letter-spacing: 0.02em;
  transition: opacity .2s, transform .15s;
}
.btn-nav:hover { opacity: 0.85; transform: translateY(-1px); }

/* ─── HERO ───────────────────────────────── */
.hero {
  min-height: 100vh;
  padding-top: var(--nav-h);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}
/* Subtle warm radial behind hero */
.hero::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 55vw; height: 100%;
  background: radial-gradient(ellipse at 80% 50%, rgba(200,132,42,0.07) 0%, transparent 65%);
  pointer-events: none;
}
/* Grid texture */
.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(30,28,25,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(30,28,25,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  pointer-events: none;
}
.hero-inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 80px 40px;
  width: 100%;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
  position: relative;
  z-index: 1;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
  animation: fadeUp .55s ease both;
}
.eyebrow-line { width: 28px; height: 1px; background: var(--accent); }
.eyebrow-text {
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.hero-name {
  font-family: var(--serif);
  font-size: clamp(52px, 5.8vw, 80px);
  font-weight: 400;
  color: var(--text1);
  line-height: 1.0;
  letter-spacing: -0.02em;
  margin-bottom: 2px;
  animation: fadeUp .55s .08s ease both;
}
.hero-name-it {
  font-family: var(--serif);
  font-size: clamp(52px, 5.8vw, 80px);
  font-weight: 500;
  font-style: italic;
  color: var(--accent);
  line-height: 1.0;
  letter-spacing: -0.02em;
  display: block;
  margin-bottom: 24px;
  animation: fadeUp .55s .12s ease both;
}
.hero-role {
  font-family: var(--mono);
  font-size: 11.5px;
  font-weight: 300;
  color: var(--text2);
  margin-bottom: 10px;
  letter-spacing: 0.04em;
  animation: fadeUp .55s .16s ease both;
}
.hero-role span { color: var(--accent); opacity: 0.5; margin: 0 6px; font-weight: 400; }
.hero-tagline {
  font-family: var(--serif);
  font-style: italic;
  font-size: 21px;
  font-weight: 400;
  color: var(--text2);
  margin-bottom: 36px;
  line-height: 1.55;
  max-width: 430px;
  animation: fadeUp .55s .2s ease both;
}
.hero-tagline em { color: var(--accent); font-style: normal; font-weight: 600; }

/* KPIs */
.kpis {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 36px;
  animation: fadeUp .55s .24s ease both;
}
.kpi {
  background: var(--bg2);
  border: 0.5px solid var(--border2);
  border-radius: var(--r);
  padding: 12px 16px;
  min-width: 100px;
  transition: border-color .2s, transform .2s;
  position: relative;
  overflow: hidden;
}
.kpi::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--accent);
  opacity: 0;
  transition: opacity .2s;
}
.kpi:hover { border-color: var(--accent); transform: translateY(-2px); }
.kpi:hover::before { opacity: 1; }
.kpi-val {
  font-family: var(--mono);
  font-size: 26px;
  font-weight: 500;
  color: var(--accent);
  display: block;
  line-height: 1;
  margin-bottom: 5px;
  letter-spacing: -0.02em;
}
.kpi-lbl {
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 300;
  color: var(--text3);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  line-height: 1.5;
}

/* CTAs */
.hero-ctas {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  animation: fadeUp .55s .28s ease both;
}
.btn-primary {
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 500;
  letter-spacing: 0.01em;
  padding: 12px 28px;
  border-radius: 8px;
  background: var(--text1);
  color: var(--bg);
  border: none;
  cursor: pointer;
  letter-spacing: 0.02em;
  transition: opacity .2s, transform .15s;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}
.btn-primary:hover { opacity: 0.85; transform: translateY(-1px); }
.btn-secondary {
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 400;
  padding: 11px 26px;
  border-radius: 8px;
  background: transparent;
  color: var(--text1);
  border: 0.5px solid var(--border2);
  cursor: pointer;
  letter-spacing: 0.02em;
  transition: background .2s, transform .15s;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}
.btn-secondary:hover { background: var(--bg2); transform: translateY(-1px); }

/* Availability */
.avail {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 300;
  letter-spacing: 0.04em;
  color: var(--text3);
  animation: fadeUp .55s .32s ease both;
}
.avail-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #4CAF7D;
  animation: pulse 2s ease-in-out infinite;
}

/* Right col — profile photo */
.hero-right { animation: fadeUp .55s .18s ease both; }
.profile-wrap {
  position: relative;
  display: inline-block;
}
.profile-photo {
  width: 230px;
  height: 230px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  border: 3px solid var(--bg2);
}
.profile-placeholder {
  width: 230px;
  height: 230px;
  border-radius: 50%;
  background: var(--bg2);
  border: 2px dashed rgba(200,132,42,0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  position: relative;
  overflow: hidden;
}
.profile-placeholder-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.profile-placeholder::before {
  content: '';
  position: absolute;
  top: -20%; right: -20%;
  width: 60%; height: 60%;
  background: radial-gradient(ellipse, rgba(200,132,42,0.1) 0%, transparent 70%);
}
.profile-mono {
  font-family: var(--serif);
  font-size: 72px;
  font-weight: 300;
  color: var(--accent);
  letter-spacing: -0.02em;
  line-height: 1;
  position: relative;
}
.profile-sub {
  font-size: 10px;
  color: var(--text3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
/* Corner accents on profile */
.corner {
  position: absolute;
  width: 16px; height: 16px;
}
.c-tl { top: 12px; left: 12px; border-top: 1.5px solid var(--accent); border-left: 1.5px solid var(--accent); border-radius: 3px 0 0 0; }
.c-tr { top: 12px; right: 12px; border-top: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent); border-radius: 0 3px 0 0; }
.c-bl { bottom: 12px; left: 12px; border-bottom: 1.5px solid var(--accent); border-left: 1.5px solid var(--accent); border-radius: 0 0 0 3px; }
.c-br { bottom: 12px; right: 12px; border-bottom: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent); border-radius: 0 0 3px 0; }
/* Floating info chip */
.hero-chip {
  position: absolute;
  bottom: -16px;
  right: -20px;
  background: var(--bg-dark);
  border-radius: 10px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 0.5px solid rgba(255,255,255,0.08);
}
.chip-dot { width: 7px; height: 7px; border-radius: 50%; background: #4CAF7D; animation: pulse 2s ease-in-out infinite; }
.chip-text { font-family: var(--mono); font-size: 10.5px; font-weight: 300; color: #F0EDE8; letter-spacing: 0.06em; white-space: nowrap; }

/* ─── SPEC STRIP ─────────────────────────── */
.spec-strip {
  background: var(--bg-dark);
  padding: 20px 40px;
  overflow: hidden;
}
.spec-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.spec-label {
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 300;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-right: 8px;
  flex-shrink: 0;
}
.spec-tag {
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 300;
  padding: 5px 13px;
  border-radius: 20px;
  background: rgba(255,255,255,0.06);
  border: 0.5px solid rgba(255,255,255,0.1);
  color: rgba(240,237,232,0.65);
  letter-spacing: 0.04em;
  transition: all .2s;
}
.spec-tag:hover { background: rgba(200,132,42,0.15); color: #E09A3A; border-color: rgba(200,132,42,0.3); }
.spec-tag.secondary {
  font-size: 9.5px;
  padding: 3px 10px;
  background: rgba(255,255,255,0.03);
  border-color: rgba(255,255,255,0.07);
  color: rgba(240,237,232,0.45);
  letter-spacing: 0.04em;
}
.spec-tag.secondary:hover { background: rgba(200,132,42,0.10); color: #C8842A; border-color: rgba(200,132,42,0.2); }
.spec-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  width: 100%;
}
.spec-row + .spec-row {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 0.5px solid rgba(255,255,255,0.06);
}
.spec-tag.hi {
  background: rgba(200,132,42,0.12);
  border-color: rgba(200,132,42,0.3);
  color: #E09A3A;
}


/* ─── MOBILE NAV ─────────────────────────── */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 4px;
  background: none;
  border: none;
}
.hamburger span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--text1);
  transition: all .25s;
}
.mobile-menu {
  display: none;
  position: fixed;
  top: var(--nav-h);
  left: 0; right: 0;
  background: rgba(247,244,239,0.97);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 0.5px solid var(--border);
  padding: 20px 40px 24px;
  z-index: 99;
}
.mobile-menu.open { display: block; }
.mobile-menu ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.mobile-menu a {
  font-size: 15px;
  color: var(--text2);
  transition: color .2s;
}
.mobile-menu a:hover { color: var(--accent); }

/* ─── SPEC STRIP MOBILE ──────────────────── */
/* ─── SECTION SHARED ─────────────────────── */
.section-lbl {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.sl-line { width: 22px; height: 1px; background: var(--accent); }
.sl-text {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

/* ─── ABOUT ──────────────────────────────── */
.about-section {
  padding: 100px 40px;
  background: var(--bg);
}
.about-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
.about-title {
  font-family: var(--serif);
  font-size: 42px;
  font-weight: 500;
  color: var(--text1);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 20px;
}
.about-title em { color: var(--accent); font-style: italic; font-weight: 400; }
.about-body {
  font-size: 14.5px;
  font-weight: 300;
  color: var(--text2);
  line-height: 1.8;
  margin-bottom: 16px;
}
.about-body strong { color: var(--text1); font-weight: 500; }
.fr-block {
  margin-top: 20px;
  padding: 14px 16px;
  background: var(--bg2);
  border-left: 2px solid rgba(200,132,42,0.4);
  border-radius: 0 var(--r) var(--r) 0;
  font-size: 13px;
  color: var(--text2);
  line-height: 1.65;
}
.fr-tag {
  font-family: var(--mono);
  font-size: 9.5px;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  display: block;
  margin-bottom: 6px;
  font-weight: 400;
}
.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.tool-card {
  background: var(--bg2);
  border: 0.5px solid var(--border);
  border-radius: var(--r);
  padding: 14px 16px;
  transition: border-color .2s;
}
.tool-card:hover { border-color: rgba(200,132,42,0.3); }
.tool-name {
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 8px;
}
.tool-list {
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 300;
  color: var(--text2);
  line-height: 1.75;
}

/* ─── WORK ───────────────────────────────── */
.work-section {
  padding: 100px 40px;
  background: var(--bg2);
}
.work-inner {
  max-width: var(--max);
  margin: 0 auto;
}
.work-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 40px;
  flex-wrap: wrap;
  gap: 16px;
}
.work-title {
  font-family: var(--serif);
  font-size: 42px;
  font-weight: 500;
  color: var(--text1);
  letter-spacing: -0.02em;
}

/* Case study cards */
.case-study {
  background: var(--bg);
  border: 0.5px solid var(--border2);
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 28px;
  transition: border-color .25s, box-shadow .25s;
}
@media (hover: hover) {
  .case-study:hover {
    border-color: rgba(200,132,42,0.3);
    box-shadow: 0 8px 32px rgba(30,28,25,0.08);
  }
}
.cs-header {
  padding: 28px 32px 22px;
  border-bottom: 0.5px solid var(--border);
}
.cs-brand-pill {
  display: inline-block;
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: var(--accent-bg);
  border: 0.5px solid rgba(200,132,42,0.25);
  padding: 4px 13px;
  border-radius: 20px;
  margin-bottom: 10px;
}
.cs-meta {
  display: flex;
  gap: 12px;
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 300;
  color: var(--text3);
  letter-spacing: 0.06em;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.cs-title {
  font-family: var(--serif);
  font-size: 28px;
  font-weight: 500;
  color: var(--text1);
  letter-spacing: -0.02em;
  margin-bottom: 8px;
  line-height: 1.2;
}
.cs-title em { color: var(--accent); font-style: italic; font-weight: 400; }
.cs-subtitle {
  font-size: 14px;
  font-weight: 300;
  color: var(--text2);
  line-height: 1.7;
  max-width: 600px;
  margin-bottom: 16px;
}
.cs-kpis {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.cs-kpi {
  background: var(--bg2);
  border: 0.5px solid var(--border2);
  border-radius: 8px;
  padding: 8px 14px;
  text-align: center;
  min-width: 78px;
}
.cs-kpi-val {
  display: block;
  font-family: var(--mono);
  font-size: 17px;
  font-weight: 500;
  color: var(--accent);
  line-height: 1;
  margin-bottom: 4px;
