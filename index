/* ── Mobile Menu ── */
function toggleMenu() {
  var menu = document.getElementById('mobile-menu');
  menu.classList.toggle('open');
}
function closeMenu() {
  document.getElementById('mobile-menu').classList.remove('open');
}

/* ── Language Switcher ── */
function setLang(lang) {
  document.getElementById('lang-en').classList.toggle('lang-active', lang === 'en');
  document.getElementById('lang-fr').classList.toggle('lang-active', lang === 'fr');

  document.querySelectorAll('[data-en]').forEach(function(el) {
    var val = lang === 'fr' ? el.getAttribute('data-fr') : el.getAttribute('data-en');
    if (!val) return;
    if (el.children.length === 0) {
      el.textContent = val;
    } else {
      el.innerHTML = val;
    }
  });

  /* Contact title special case (has nested <em>) */
  var ctEn = document.getElementById('contact-title-en');
  var ctFr = document.getElementById('contact-title-fr');
  if (ctEn && ctFr) {
    ctEn.style.display = lang === 'fr' ? 'none' : '';
    ctFr.style.display = lang === 'fr' ? '' : 'none';
  }

  /* About section: hide/show EN vs FR block */
  var aboutEn = document.getElementById('about-en');
  var aboutFr = document.getElementById('about-fr');
  if (aboutEn) aboutEn.style.display = lang === 'fr' ? 'none' : '';
  if (aboutFr) aboutFr.style.display = lang === 'fr' ? '' : 'none';

  /* Case study lang blocks */
  document.querySelectorAll('.cs-lang').forEach(function(el) { el.classList.remove('on'); });
  var suffix = lang === 'fr' ? '-fr' : '-en';
  ['c0','c1','c2','c3','c4'].forEach(function(id) {
    var el = document.getElementById(id + suffix);
    if (el) el.classList.add('on');
  });

  /* Hero tagline special case */
  var tlEn = document.getElementById('hero-tagline-en');
  var tlFr = document.getElementById('hero-tagline-fr');
  if (tlEn && tlFr) {
    tlEn.style.display = lang === 'fr' ? 'none' : '';
    tlFr.style.display = lang === 'fr' ? '' : 'none';
  }

  localStorage.setItem('lang', lang);
}

// Auto-apply saved preference on load
(function() {
  var saved = '';
  try { saved = localStorage.getItem('site-lang'); } catch(e) {}
  setLang(saved === 'fr' ? 'fr' : 'en');
})();

function tog(btn, csId, lang) {
  const body = btn.closest('.cs-body');
  body.querySelectorAll('.lt').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  body.querySelectorAll('.cs-lang').forEach(el => el.classList.remove('on'));
  const target = body.querySelector('#' + csId + '-' + lang);
  if (target) target.classList.add('on');
}

