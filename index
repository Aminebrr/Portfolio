.cs-visual {
  position: relative;
  height: 380px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  isolation: isolate;
  background: #c8842a;
}

/* Single image layer only */
.takeaway-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url("takeaway-bg.png") center center / cover no-repeat;
  transform: scale(1);
  transform-origin: center;
  transition: transform .55s ease, filter .55s ease;
  z-index: 0;
}

.cs-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at 70% 25%, rgba(255,145,0,0.22) 0%, rgba(255,145,0,0.08) 22%, transparent 48%),
    linear-gradient(to top, rgba(0,0,0,0.68) 0%, rgba(0,0,0,0.22) 42%, rgba(0,0,0,0.08) 100%);
  transition: opacity .45s ease;
}

.cs-overlay::after {
  content: "";
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
  pointer-events: none;
}

.cs-content {
  position: relative;
  z-index: 2;
  padding: 30px;
  color: #fff;
  max-width: 560px;
}

.cs-content .cs-title,
.cs-content .cs-meta {
  color: #fff;
}

.cs-content .cs-title {
  font-size: clamp(32px, 4vw, 46px);
  line-height: 0.98;
  letter-spacing: -0.03em;
  margin-bottom: 0;
  text-shadow: 0 2px 14px rgba(0,0,0,0.18);
}

.cs-content .cs-meta {
  font-size: 11px;
  line-height: 1.5;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.92;
  margin-bottom: 12px;
}

.case-study {
  position: relative;
  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
}

.case-study:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 42px rgba(30,28,25,0.13);
}

.case-study:hover .takeaway-bg::before {
  transform: scale(1.045);
  filter: saturate(1.08) contrast(1.03);
}

.case-study:hover .cs-overlay {
  opacity: 0.92;
}

.case-study:hover .cs-visual::after {
  content: "";
  position: absolute;
  inset: -18%;
  background: radial-gradient(circle at 68% 26%, rgba(255,166,0,0.20) 0%, rgba(255,166,0,0.10) 18%, transparent 42%);
  z-index: 1;
  pointer-events: none;
  animation: takeawayGlow 1.8s ease-out forwards;
}

@keyframes takeawayGlow {
  0% {
    opacity: 0;
    transform: scale(0.92);
  }
  35% {
    opacity: 1;
  }
  100% {
    opacity: 0.65;
    transform: scale(1.04);
  }
}

@media (max-width: 900px) {
